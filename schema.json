{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inline Array Convention",
  "description": "Schema for inline zarr arrays",
  "type": "object",
  "properties": {
    "values": {
      "type": "array"
    },
    "data_type": {
      "$ref": "#/$defs/metadata_item"
    },
    "shape": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "dimension_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    }
  },
  "required": [
    "values"
  ],
  "additionalProperties": false,
  "$defs": {
    "metadata_item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "configuration": {
              "type": "object"
            }
          },
          "required": [
            "name"
          ]
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
